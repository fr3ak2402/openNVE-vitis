# Stand-in for boards/Makefile of github.com/Xilinx/kria-apps-firmware (same interface:
# make APPS=<board>/<app>/ DESTDIR=... install), for tests/test_install.sh.
APPS ?= $(wildcard kv260/*/)
BITS := $(wildcard $(patsubst %,%*.bit,$(APPS)))
DTSIS := $(wildcard $(patsubst %,%*.dtsi,$(APPS)))
XCLBINS := $(wildcard $(patsubst %,%*.xclbin,$(APPS)))
JSONS := $(wildcard $(patsubst %,%shell.json,$(APPS)))
BINS := $(patsubst %.bit,%.bin,$(BITS))
DTBOS := $(patsubst %.dtsi,%.dtbo,$(DTSIS))

%.dtbo: %.dtsi
	dtc -I dts -O dtb -o $@ $<

%.bif: %.bit
	sed 's#@BIT@#$<#' <template.bif >$@

%.bin: %.bif
	bootgen -image $< -arch zynqmp -o $@ -w

install: $(BINS) $(DTBOS) $(XCLBINS) $(JSONS)
	for f in $^; do \
	    app=$$(basename $$(dirname $$f)); board=$$(basename $$(dirname $$(dirname $$f))); \
	    install -D -m 644 $$f $(DESTDIR)/lib/firmware/xilinx/$$board-$$app/$$(basename $$f); \
	done
